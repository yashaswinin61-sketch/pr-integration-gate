{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR integration gate test matrix",
  "type": "object",
  "required": ["tests"],
  "properties": {
    "$schema": {"type": "string"},
    "defaults": {"$ref": "#/$defs/settings"},
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [{"$ref": "#/$defs/settings"}],
        "type": "object",
        "required": ["id", "stages"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
          "enabled": {"type": "boolean"},
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": {"type": "string"},
                "seconds": {"type": "number", "minimum": 0},
                "outcome": {"enum": ["pass", "fail", "flaky"]}
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "infra_retries": {"type": "integer", "minimum": 0, "maximum": 3},
        "poll_seconds": {"type": "number", "minimum": 0.1},
        "capacity_wait_seconds": {"type": "integer", "minimum": 0}
      }
    }
  }
}
